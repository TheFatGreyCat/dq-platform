{
  "dataset": "silver.transactions",
  "workflow": "WRITE_GATE",
  "purpose": "default",
  "suite": {
    "format": "dq-rules/v3",
    "workflow": "WRITE_GATE",
    "description": "DQ gate 2: Bronze -> Silver cho bảng giao dịch, nhóm theo 6 data quality dimensions",
    "parameters": {
      "partition_start": "đầu ngày dt (yyyy-MM-dd 00:00:00), job truyền vào",
      "partition_end": "đầu ngày dt+1, job truyền vào",
      "source_row_count": "số giao dịch khác nhau ở Bronze (sau dedup), job tính từ dữ liệu nguồn"
    },
    "rules": [
      {
        "rule_id": "row_count_min",
        "dimension": "completeness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "description": "batch đủ lượng tối thiểu, tránh publish partition rỗng/cụt",
        "check": {
          "kind": "size",
          "assert": {
            "op": ">=",
            "value": 1000
          }
        }
      },
      {
        "rule_id": "row_count_reconcile",
        "dimension": "completeness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "description": "đối soát với Bronze: transform không làm mất hay nhân bản giao dịch",
        "check": {
          "kind": "size",
          "assert": {
            "op": "==",
            "value": {
              "param": "source_row_count"
            }
          }
        }
      },
      {
        "rule_id": "transaction_id_not_null",
        "dimension": "completeness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "complete",
          "column": "transaction_id"
        }
      },
      {
        "rule_id": "subscriber_id_not_null",
        "dimension": "completeness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "complete",
          "column": "subscriber_id"
        }
      },
      {
        "rule_id": "msisdn_not_null",
        "dimension": "completeness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "complete",
          "column": "msisdn"
        }
      },
      {
        "rule_id": "amount_not_null",
        "dimension": "completeness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "description": "null cả khi Bronze có giá trị nhưng cast decimal thất bại",
        "check": {
          "kind": "complete",
          "column": "amount"
        }
      },
      {
        "rule_id": "status_not_null",
        "dimension": "completeness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "complete",
          "column": "status"
        }
      },
      {
        "rule_id": "event_time_not_null",
        "dimension": "completeness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "complete",
          "column": "event_time"
        }
      },
      {
        "rule_id": "province_code_completeness",
        "dimension": "completeness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "completeness",
          "column": "province_code",
          "assert": {
            "op": ">=",
            "value": "0.9"
          }
        }
      },
      {
        "rule_id": "transaction_id_unique",
        "dimension": "uniqueness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "description": "khóa kỹ thuật; job đã dedup Kafka replay nên fail = lỗi transform",
        "check": {
          "kind": "unique",
          "columns": [
            "transaction_id"
          ]
        }
      },
      {
        "rule_id": "business_duplicate",
        "dimension": "uniqueness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "description": "trùng nghiệp vụ: cùng thuê bao, cùng số tiền, cùng thời điểm nhưng khác transaction_id (nghi trừ tiền 2 lần)",
        "check": {
          "kind": "unique",
          "columns": [
            "subscriber_id",
            "msisdn",
            "amount",
            "event_time"
          ]
        }
      },
      {
        "rule_id": "schema_exact",
        "dimension": "validity",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "schema_columns",
          "exact": true,
          "columns": [
            "transaction_id",
            "subscriber_id",
            "msisdn",
            "amount",
            "status",
            "province_code",
            "event_time",
            "dt"
          ]
        }
      },
      {
        "rule_id": "amount_type",
        "dimension": "validity",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "schema_type",
          "column": "amount",
          "type": "decimal"
        }
      },
      {
        "rule_id": "event_time_type",
        "dimension": "validity",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "schema_type",
          "column": "event_time",
          "type": "timestamp"
        }
      },
      {
        "rule_id": "msisdn_format",
        "dimension": "validity",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "pattern",
          "column": "msisdn",
          "regex": "^84[0-9]{9}$",
          "assert": {
            "op": ">=",
            "value": "0.97"
          }
        }
      },
      {
        "rule_id": "amount_range",
        "dimension": "validity",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "range",
          "column": "amount",
          "min": 0,
          "max": 100000000
        }
      },
      {
        "rule_id": "status_domain",
        "dimension": "validity",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "check": {
          "kind": "in_set",
          "column": "status",
          "values": [
            "SUCCESS",
            "FAILED",
            "REFUNDED"
          ]
        }
      },
      {
        "rule_id": "msisdn_carrier_prefix",
        "dimension": "accuracy",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "description": "đúng định dạng chưa đủ: số phải thuộc đầu số di động đang cấp phát thực tế",
        "check": {
          "kind": "pattern",
          "column": "msisdn",
          "regex": "^84(3|5|7|8|9)[0-9]{8}$",
          "assert": {
            "op": ">=",
            "value": "0.99"
          }
        }
      },
      {
        "rule_id": "amount_mean",
        "dimension": "accuracy",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "description": "giá trị trung bình phải sát thực tế kinh doanh; lệch mạnh = sai đơn vị tiền hoặc lỗi nguồn",
        "check": {
          "kind": "mean",
          "column": "amount",
          "assert": {
            "op": "between",
            "min": 10000,
            "max": 500000
          }
        }
      },
      {
        "rule_id": "event_time_in_partition",
        "dimension": "consistency",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "description": "event_time phải nhất quán với partition dt chứa nó",
        "check": {
          "kind": "sql_predicate",
          "columns": [
            "event_time"
          ],
          "predicate": "event_time IS NULL OR (event_time >= TIMESTAMP '${partition_start}' AND event_time < TIMESTAMP '${partition_end}')"
        }
      },
      {
        "rule_id": "freshness_end_of_day",
        "dimension": "timeliness",
        "scope": "PARTITION",
        "stage": "CANDIDATE",
        "description": "freshness: đã có giao dịch của giờ cuối ngày, nếu không thì upstream về trễ/batch bị cắt",
        "check": {
          "kind": "sql_metric",
          "assert": {
            "op": "==",
            "value": 1
          },
          "sql": "SELECT CAST(max(event_time) >= TIMESTAMP '${partition_end}' - INTERVAL 60 MINUTES AS DOUBLE) FROM ${batch}"
        }
      },
      {
        "rule_id": "clean_row_count_min",
        "dimension": "completeness",
        "scope": "PARTITION",
        "stage": "CLEAN",
        "description": "sau khi loại dòng quarantine vẫn còn dữ liệu để ghi Silver",
        "check": {
          "kind": "size",
          "assert": {
            "op": ">=",
            "value": 1
          }
        }
      }
    ]
  },
  "policy": {
    "rules": [
      {
        "rule_id": "amount_mean",
        "action": "OBSERVE",
        "required": false
      },
      {
        "rule_id": "amount_not_null",
        "action": "QUARANTINE",
        "required": true
      },
      {
        "rule_id": "amount_range",
        "action": "QUARANTINE",
        "required": true
      },
      {
        "rule_id": "amount_type",
        "action": "BLOCK",
        "required": true
      },
      {
        "rule_id": "business_duplicate",
        "action": "OBSERVE",
        "required": false
      },
      {
        "rule_id": "clean_row_count_min",
        "action": "BLOCK",
        "required": true
      },
      {
        "rule_id": "event_time_in_partition",
        "action": "QUARANTINE",
        "required": true
      },
      {
        "rule_id": "event_time_not_null",
        "action": "QUARANTINE",
        "required": true
      },
      {
        "rule_id": "event_time_type",
        "action": "BLOCK",
        "required": true
      },
      {
        "rule_id": "freshness_end_of_day",
        "action": "OBSERVE",
        "required": false
      },
      {
        "rule_id": "msisdn_carrier_prefix",
        "action": "OBSERVE",
        "required": false
      },
      {
        "rule_id": "msisdn_format",
        "action": "QUARANTINE",
        "required": true
      },
      {
        "rule_id": "msisdn_not_null",
        "action": "QUARANTINE",
        "required": true
      },
      {
        "rule_id": "province_code_completeness",
        "action": "OBSERVE",
        "required": false
      },
      {
        "rule_id": "row_count_min",
        "action": "BLOCK",
        "required": true
      },
      {
        "rule_id": "row_count_reconcile",
        "action": "BLOCK",
        "required": true
      },
      {
        "rule_id": "schema_exact",
        "action": "BLOCK",
        "required": true
      },
      {
        "rule_id": "status_domain",
        "action": "QUARANTINE",
        "required": true
      },
      {
        "rule_id": "status_not_null",
        "action": "QUARANTINE",
        "required": true
      },
      {
        "rule_id": "subscriber_id_not_null",
        "action": "QUARANTINE",
        "required": true
      },
      {
        "rule_id": "transaction_id_not_null",
        "action": "QUARANTINE",
        "required": true
      },
      {
        "rule_id": "transaction_id_unique",
        "action": "BLOCK",
        "required": true
      }
    ],
    "min_candidate_rows": 1000,
    "min_clean_rows": 1,
    "max_quarantine_ratio": "0.05",
    "anomaly": {
      "enabled": false
    }
  }
}
